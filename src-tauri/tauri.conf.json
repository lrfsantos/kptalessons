{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corretor CNA",
  "version": "0.1.0",
  "identifier": "com.cna.corretor",
  "build": {
    "frontendDist": "../poc-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node.exe",
      "resources/src-node/**/*",
      "resources/lib/**/*",
      "resources/login.js",
      "resources/scraper.js",
      "resources/executor.js",
      "resources/corrigir.js",
      "resources/instrucoes_correcao.md",
      "resources/ui/painel.html",
      "resources/ui/painel.css",
      "resources/ui/painel.js",
      "resources/poc-ui/**/*",
      "resources/node_modules/playwright-core/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}

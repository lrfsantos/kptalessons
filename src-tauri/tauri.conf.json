{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corretor CNA POC",
  "version": "0.1.0",
  "identifier": "com.cna.corretorpoc",
  "build": {
    "frontendDist": "../poc-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node.exe",
      "resources/src-node/**/*",
      "resources/lib/**/*",
      "resources/ui/painel.html",
      "resources/poc-ui/**/*",
      "resources/node_modules/playwright-core/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}

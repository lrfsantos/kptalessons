# ============================================================
# CNA Corretor — exemplo de variáveis de ambiente (PLACEHOLDERS)
# Copie para .env se quiser sobrescrever padrões. NÃO há segredos:
# o login no portal é manual (npm run login -> session.json, fora do git).
# Uso: node --env-file=.env scraper.js
# ============================================================

# Abrir navegador sem janela visível (true/false)
HEADLESS=false

# Atividades por lote de MD (IAs gratuitas têm contexto menor)
LOTE_SIZE=8

# Timeout de navegação em ms
NAV_TIMEOUT=60000
